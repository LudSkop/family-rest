# Скопіюйте цей файл у .env.local і підставте свої значення:
#   cp .env.example .env.local
# .env.local не потрапляє в git — секрети тримайте лише там.

# Адреса бекенда Family Rest разом із префіксом /api/v1, без слеша в кінці.
# Лише для сервера Next.js (без NEXT_PUBLIC_), тож у браузер вона не потрапляє.
API_URL=https://your-backend.example.com/api/v1
